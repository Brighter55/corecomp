# Committed on purpose -- this is test configuration, not a secret.
#
# client/.env is gitignored, so on a clean checkout (CI, a fresh clone, a new
# machine) VITE_BACKEND_BASE_URL is undefined, and api.js then builds URLs like
# "undefined/accounts/sign-out". The suite passed locally and failed in CI for
# exactly that reason.
#
# Vite loads .env.test in test mode and it takes precedence over .env, so this
# value is what the tests see on every machine.
#
# The tests never make real requests -- fetch and the api module are mocked --
# so this only has to be deterministic, not reachable.
VITE_BACKEND_BASE_URL=http://localhost:8000
